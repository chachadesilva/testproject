{
    "name": "novacore/landing-page",
    "type": "project",
    "description": "Modern Laravel landing page for NovaCore Technologies software company.",
    "keywords": ["laravel", "landing-page", "software-company"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
